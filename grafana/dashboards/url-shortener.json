{
  "title": "URL Shortener",
  "uid": "url-shortener",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 100, "type": "row", "title": "HTTP overview (RED)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },
    {
      "id": 1, "type": "timeseries", "title": "Request rate by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (route, method)", "legendFormat": "{{method}} {{route}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2, "type": "timeseries", "title": "Error rate (%)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 * sum(rate(http_requests_total{status=~\"4..|5..\"}[5m])) / sum(rate(http_requests_total[5m]))", "legendFormat": "error %", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] }
    },
    {
      "id": 3, "type": "timeseries", "title": "Latency p50/p95/p99 by route",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p50 {{route}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p95 {{route}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p99 {{route}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },

    { "id": 101, "type": "row", "title": "Cache effectiveness", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "collapsed": false },
    {
      "id": 4, "type": "timeseries", "title": "Cache lookups by tier",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(cache_lookups_total[5m])) by (tier)", "legendFormat": "{{tier}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 5, "type": "timeseries", "title": "Cache hit rate (lru+redis) %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 * sum(rate(cache_lookups_total{tier=~\"lru|redis\"}[5m])) / sum(rate(cache_lookups_total[5m]))", "legendFormat": "hit rate", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },

    { "id": 102, "type": "row", "title": "DB pool health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "collapsed": false },
    {
      "id": 6, "type": "timeseries", "title": "Avg acquire wait by role",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_pool_acquire_duration_seconds_total[5m]) / rate(pg_pool_acquire_count_total[5m])", "legendFormat": "{{role}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 7, "type": "timeseries", "title": "Idle vs max connections",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_pool_idle_conns", "legendFormat": "idle {{role}}", "refId": "A" },
        { "expr": "pg_pool_max_conns", "legendFormat": "max {{role}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Empty-acquire rate (queued for a conn)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_pool_empty_acquire_count_total[5m])", "legendFormat": "{{role}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },

    { "id": 103, "type": "row", "title": "Reliability signals", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "collapsed": false },
    {
      "id": 9, "type": "timeseries", "title": "Code collision rate",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(shorten_code_collisions_total[5m])", "legendFormat": "collisions", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 10, "type": "timeseries", "title": "Singleflight dedup rate",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(resolve_dedup_total[5m])", "legendFormat": "deduped", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },

    { "id": 104, "type": "row", "title": "Go runtime", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "collapsed": false },
    {
      "id": 11, "type": "timeseries", "title": "Goroutines",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "go_goroutines", "legendFormat": "goroutines", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 12, "type": "timeseries", "title": "Heap in use",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "go_memstats_heap_inuse_bytes", "legendFormat": "heap", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 13, "type": "timeseries", "title": "GC pause time",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(go_gc_duration_seconds_sum[5m])", "legendFormat": "gc pause/s", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
